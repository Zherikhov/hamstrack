# Copy this file to `.env` on the server, next to docker-compose.prod.yml.
# docker compose auto-loads `.env` from the same directory.

# ── Container image ────────────────────────────────────────────────
# GitHub owner/org that hosts the ghcr.io/<owner>/hamstrack image.
# MUST be lowercase (GitHub image paths are case-sensitive).
GITHUB_OWNER=your-github-username

# ── Resources ──────────────────────────────────────────────────────
# Memory ceiling for the app CONTAINER (compose `mem_limit`; any docker size
# suffix — 1g / 1536m). Default 1g. This is the heap dial: the image runs the JVM
# with -XX:MaxRAMPercentage=50, so the heap is half of whatever you set here —
# 1g → 512 MB heap, 2g → 1 GB heap — and the other half covers the non-heap memory
# a JVM in a container still needs (metaspace, thread stacks, code cache, direct
# buffers). Sizing it too close to the heap gets the container OOM-KILLED (exit
# 137) instead of throwing OutOfMemoryError, which is the harder failure to
# diagnose. Do NOT set it to the size of the whole box: PostgreSQL, Caddy and — if
# you run it — the observability stack (whose own mem_limits sum to ~1 GB) need
# their share.
#
# UPGRADING FROM BEFORE 0.17.0 ON A HOST LARGER THAN 2 GB: leaving this at the
# default is a heap CUT. The JVM used to take ~25% of HOST RAM, so a 4 GB host ran
# a ~1 GB heap and an 8 GB host ~2 GB, where 1g here gives 512 MB on both.
# Break-even is a 2 GB host; below it you gain. Full note, with the sizing rule:
# "The heap is bounded from 0.17.0" in docs/self-hosting.md.
#
# 512 MB is also the heap REPORTS_MAX_ROWS (further down) is costed against — its
# worst case of ~95 MB per request is 95 MB *of this* — so raising either one is
# the occasion to re-read the other.
#
# From 4g up the 50/50 split over-reserves, because the non-heap need is largely
# CONSTANT: metaspace and the code cache do not grow with the heap. Pair a bigger
# limit with an explicit heap — JAVA_TOOL_OPTIONS below, roughly this limit minus
# ~700 MB. (At 2g the waste is only ~300 MB, so a 4 GB host needs nothing beyond
# the limit itself.)
#
# ---------------------------------------------------------------------------
# -Xmx IS THE ONLY FORM THAT WORKS. JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
# loses to the image's own copy of that flag and changes NOTHING — and the JVM
# prints "Picked up JAVA_TOOL_OPTIONS: …" either way. That line says the variable
# was READ, not that it was applied, so the percentage form looks like it worked.
# ---------------------------------------------------------------------------
#
# Unlike the application settings below, an EMPTY value here is harmless: Compose
# reads it, not Spring, so "APP_MEMORY_LIMIT=" falls back to 1g rather than
# stopping the boot.
#APP_MEMORY_LIMIT=1g
# Explicit heap, for a container limit of 4g or more (see just above). Passed to
# the JVM, not to Compose. Leave it unset below 4g — the image's 50% of the
# container limit is the right split there.
#JAVA_TOOL_OPTIONS=-Xmx3g

# ── Deployment model ───────────────────────────────────────────────
# cloud = hosted SaaS (S3 storage by default); dc = self-hosted (local
# disk by default). Storage/other per-model defaults come from this.
SPRING_PROFILES_ACTIVE=cloud

# ── Database ───────────────────────────────────────────────────────
DB_USERNAME=DB_USERNAME
DB_PASSWORD=DB_PASSWORD
# Connection-pool sizing (optional). Defaults: max 10, min-idle 5. Raise the max
# for higher concurrency, but keep (max × app replicas) under Postgres
# max_connections. With open-in-view=false connections are held only per
# transaction, so a small pool goes a long way.
#DB_POOL_MAX_SIZE=10
#DB_POOL_MIN_IDLE=5
# How long a transaction may wait for a row lock before giving up, in milliseconds.
# FROM 0.17.0 THIS APPLIES TO EVERY TRANSACTION, not only the few that lock on
# purpose: an ordinary edit queued behind a long-running change now fails after 3s
# with a retryable 409 instead of waiting indefinitely. It is issued together with
# DB_STATEMENT_TIMEOUT_MS below, because statement_timeout counts lock-wait time —
# without this, a contended write would be cancelled by THAT bound and answered a
# 422 telling the caller not to retry, when retrying is exactly what works.
# Applied with SET LOCAL, never on the datasource, so Flyway migrations are
# unaffected and still wait as long as they need. Exceeding it is a 409 +
# Retry-After. Valid range 100–60000 — an out-of-range value (0 means
# "wait for ever" to PostgreSQL) fails startup rather than being clamped silently.
# To turn it off, leave the line COMMENTED OUT (as below) — not blank. "DB_LOCK_
# TIMEOUT_MS=" is an empty value, not an absent one, and binding empty to the
# app's primitive int aborts startup; only an absent variable falls back to 3000.
# CAPPED IN PRACTICE BY THE LINE BELOW: DB_STATEMENT_TIMEOUT_MS must stay at least
# 2x this value, so while that one is at its default 10000, this may not exceed
# 5000 — a higher value here stops the boot naming BOTH properties. Raise them
# together.
#DB_LOCK_TIMEOUT_MS=3000
# How long ANY ONE STATEMENT may run before PostgreSQL cancels it, in milliseconds.
# Applied with SET LOCAL to every transaction the app opens (not to Flyway, which
# runs its own — a migration is allowed to take minutes where a report is not).
# Exceeding it is a 422 with errorType STATEMENT_BUDGET_EXCEEDED and no Retry-After.
# NEW IN 0.17.0, AND IT CAN TURN A SLOW REPORT INTO AN ERROR ON A LARGE INSTALL:
# before this release a query could run for ever. If a report, a search or a member
# removal starts failing after upgrading, raise this. See docs/self-hosting.md
# "Statements are bounded from 0.17.0" for a size-to-value table.
# Must be at least 2x DB_LOCK_TIMEOUT_MS or the app refuses to start (the smaller
# bound always fires first, and a statement bound below the lock bound would replace
# the retryable 409 with a 422 that is not retryable). Valid range 1000-600000; 0
# means "no bound" to PostgreSQL and is refused. THE 2x RULE IS THE BINDING ONE:
# with DB_LOCK_TIMEOUT_MS at its default 3000, the smallest value that boots is
# 6000, not the 1000 the range suggests.
# RAISING THIS IS NOT FREE: every second you add is a second one request may hold
# one of your DB_POOL_MAX_SIZE connections (default 10, set further up this file), so the
# same pool serves fewer concurrent slow requests. Past ~30s, raise the pool too.
# Same "comment it out, never blank" rule as DB_LOCK_TIMEOUT_MS —
# "DB_STATEMENT_TIMEOUT_MS=" is an empty value, not an absent one, and binding
# empty to the app's primitive int aborts startup.
#DB_STATEMENT_TIMEOUT_MS=10000

# ── Security ───────────────────────────────────────────────────────
# Min 32 bytes or the app fails fast at startup.
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
# Access-token lifetime (ISO-8601 duration). Short by design — the refresh
# cookie renews it; a longer value widens the replay window for a leaked token.
#JWT_ACCESS_TOKEN_TTL=PT30M
# Auth rate-limiter: trust the rightmost X-Forwarded-For for per-IP keying.
# The bundled docker-compose.prod.yml forces this to true (traffic always comes
# through Caddy, which strips client-supplied XFF). Only override here if you run
# WITHOUT the bundled Caddy AND behind your own trusted proxy that strips XFF;
# leave it false (the app default) when the app port is directly reachable, or
# clients can spoof XFF to bypass the per-IP auth limit.
#RATE_LIMIT_TRUST_FORWARDED_FOR=true

# ── Uploads (optional) ─────────────────────────────────────────────
# Per-file business limit (enforced in-app) and the hard servlet ceiling.
# MAX_FILE_SIZE must stay <= MAX_UPLOAD_SIZE; match your proxy body limit to
# the ceiling. ALLOWED_EXTENSIONS is a case-insensitive comma-separated list.
#ATTACHMENT_MAX_FILE_SIZE=20MB
#ATTACHMENT_MAX_UPLOAD_SIZE=25MB
#ATTACHMENT_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,bmp,svg,pdf,txt,csv,log,md,json,doc,docx,xls,xlsx,ppt,pptx,zip

# ── Board ──────────────────────────────────────────────────────────
# Max issues a single board query returns — a guard against unbounded board
# loads on very large projects. Raise only if boards legitimately need more.
# Valid range 1–20000 (20000 is the most assembled issues ONE unpaged response may
# build, the same budget the agile planning view uses) — an out-of-range value fails
# startup rather than being clamped silently. A 0 here used to bind quietly and empty
# every board in the install.
#BOARD_MAX_ISSUES=500

# ── Classification (labels, components, versions) ──────────────────
# Max labels attachable to one issue. A DoS guard, identical in DC and Cloud;
# exceeding it is a 422, not a silent truncation. Valid range 1–100 — an
# out-of-range value fails startup rather than being clamped silently.
#MAX_LABELS_PER_ISSUE=20
# Max labels in one workspace's catalog (any member may create labels, so the
# catalog needs a ceiling). 422 when full. Valid range 1–100000.
#MAX_LABELS_PER_WORKSPACE=1000
# Max components in one project's catalog. Creating them needs a project curator,
# but that is no volume barrier (anyone can create their own workspace and owns
# every project in it), and HQL name resolution loads every visible project's whole
# component catalog on each search. 422 when full. Valid range 1–100000.
#MAX_COMPONENTS_PER_PROJECT=500
# Max versions linkable to ONE issue, PER LINK TYPE — i.e. this many fix versions
# and, independently, this many affects versions. 422 beyond it. Valid range 1–100.
#MAX_VERSION_LINKS_PER_ISSUE=20
# Max versions in one project's catalog — same reasoning as MAX_COMPONENTS_PER_PROJECT
# (curator-gated is not a volume barrier, and every visible project's version names are
# loaded on each search; the versions list endpoint is unpaged too). Archived and
# released versions count. 422 when full. Valid range 1–100000.
#MAX_VERSIONS_PER_PROJECT=500

# ── Agile (sprints, Scrum board, backlog ranking) ──────────────────
# Same posture as the classification caps: DoS guards and defaults, identical in DC
# and Cloud, no feature flag. All are validated — an out-of-range value fails startup
# rather than being clamped silently.
#
# Max issues rendered per section in the planning view (GET .../backlog). Together with
# AGILE_MAX_OPEN_SPRINTS this bounds the response size ((sprints + 1) x this). A
# truncated section still reports honest whole-section totals. Valid range 1–2000.
#AGILE_SECTION_MAX_ISSUES=300
# Max FUTURE + ACTIVE sprints in one project (COMPLETED ones are history and cannot be
# started, so they don't count). 422 on sprint creation when full. Valid range 1–100.
#AGILE_MAX_OPEN_SPRINTS=20
# NOTE — these two are validated TOGETHER as well: AGILE_SECTION_MAX_ISSUES ×
# (AGILE_MAX_OPEN_SPRINTS + 1) must not exceed 20000, because ONE GET .../backlog
# assembles that many issues in a single unpaged response. Both at their individual
# maxima would be ~202000 rows in one response — the app refuses to start instead of
# handing you an OOM at 3am.
#
# Default iteration length in days — the end date a sprint start assumes when the
# request carries none. Valid range 1–90.
#AGILE_DEFAULT_SPRINT_LENGTH_DAYS=14
# Max issue ids in one bulk "move to sprint" request; beyond it the request is a 400 and
# the client is expected to chunk. Valid range 1–500.
#AGILE_MAX_BULK_MOVE=100

# ── Reports ────────────────────────────────────────────────────────
# Bounds on every report (created-vs-resolved flow today; cycle time, aging WIP,
# sprint burn-up and velocity as they land). Product bounds, NOT a plan or tier —
# identical in dc and cloud, no profile override. If reporting depth were ever
# limited per deployment it would be by lowering these numbers, never by a second
# code path. All three fail startup when out of range instead of being clamped.
#
# Widest window one report may span, in DAYS, counting both endpoints. A wider
# request is refused with 400 and this cap named in the message — it is never
# silently narrowed, because a chart of a window nobody asked for is exactly how a
# reporting feature earns "these numbers don't match what I expected". Valid range
# 1–3650; at daily buckets the window length IS the number of points in the
# response, which is what the upper bound guards.
# NOTE: a value UNDER 90 is fine and is not a trap — the endpoint's own default
# window is min(90, this), so the parameterless request the reports page makes on
# load is always inside the cap. What is never done is CLAMPING a window a caller
# explicitly asked for: that is a 400 naming this number.
#REPORTS_MAX_WINDOW_DAYS=365
# Most issue ROWS one report may materialise before it declares itself truncated
# (every report response carries meta.truncated + meta.cap, and the UI prints it).
# It does not bite on the flow report, which aggregates in PostgreSQL and returns
# one row per bucket; it is the budget for the row-level reports. Valid range
# 1–50000. The ceiling is a byte budget wearing a row count: a shipped row costs
# roughly 1.9 KB of transient heap at worst, so 50000 is ~95 MB for a single request
# — 95 MB OF the 512 MB heap that the default APP_MEMORY_LIMIT=1g gives you (see
# Resources at the top). Size this against the heap you actually run, not the default.
#REPORTS_MAX_ROWS=20000
# How many report requests ONE USER may make per minute across the whole reports
# surface (every .../projects/*/reports/** endpoint, not per report) PLUS
# POST .../workspaces/*/search/insights, the Insights panel — a report that does NOT
# live under the reports path (its dataset is an HQL query, so it hangs off /search)
# and is bound to this limiter explicitly rather than by prefix. For the
# project-scoped reports this is the only bound on the WORK a report does — the
# window cap above bounds the response array, not the cost of producing it, and the
# "open at window start" balance is O(project history) by design while
# Cache-Control: private means no shared cache ever absorbs a repeat. Insights is the
# one exception to "only bound": it is ALSO inside SEARCH_REQUESTS_PER_MINUTE below,
# so it spends both budgets and THE LOWER CONFIGURED VALUE BINDS — lowering EITHER
# property lowers the panel. Past the budget: 429 + Retry-After, never
# a narrowed or approximated report. Valid range 1–10000. THERE IS NO "UNLIMITED"
# VALUE: 0 is out of range and fails startup; the off switch is RATE_LIMIT_ENABLED,
# which turns off every limiter in the app.
#REPORTS_REQUESTS_PER_MINUTE=60
# To keep any of the three REPORTS_* defaults above, leave the line COMMENTED OUT — not
# blank. "REPORTS_MAX_WINDOW_DAYS=" is an empty value, not an absent one, and binding
# empty to the app's primitive int aborts startup; only an absent variable falls back
# to the documented default. This matters more here than elsewhere: the window cap is
# quoted back to API callers inside a 400, so a value nobody chose would be presented
# to users as though somebody had.

# ── Search ─────────────────────────────────────────────────────────
# The HQL surface has its own per-principal budget, separate from the reports one
# above. Same shape as REPORTS_REQUESTS_PER_MINUTE: fails startup out of range,
# and an empty value aborts the boot rather than restoring the default.
#
# How many SEARCH-surface requests ONE USER may make per minute: POST .../search,
# GET .../search/schema, GET .../search/suggest, POST .../search/insights and EVERY
# SAVED-FILTER operation under .../filters/** (GET and DELETE included -- the binding
# is by path, not by method). Saved filters are on this budget because HQL validation
# is search-surface work wherever it is mounted: validating a filter builds the same
# resolution context .../search/schema pays for -- about eight statements, including a
# workspace-wide label projection and a full member scan -- so creating one with a
# deliberately invalid body was an unthrottled eight-query refusal loop. Charged here
# rather than to the reports pot because a saved filter IS a saved search. (The
# panel spends BOTH budgets, and the LOWER CONFIGURED VALUE binds — it sits on the
# reports limiter deliberately, because removing that binding would raise the panel's
# allowance to the search budget as a side effect, so lowering EITHER property lowers
# the panel). Search is not the cheap surface it looks like: up to 50 leaf predicates
# per query, a text ~ leaf is two unanchored unindexable LIKEs over a TEXT column,
# and the endpoint runs the whole predicate TWICE per request (count + page). Its own
# budget rather than the reports one because a person typing legitimately fires
# several requests a minute;
# 120 is roughly ten times ordinary SPA use. Past it: 429 + Retry-After. Valid range
# 1-10000. THERE IS NO "UNLIMITED" VALUE: 0 fails startup; the off switch is
# RATE_LIMIT_ENABLED. Leave the line COMMENTED OUT to keep the default — an empty
# "SEARCH_REQUESTS_PER_MINUTE=" aborts the boot rather than restoring 120.
#SEARCH_REQUESTS_PER_MINUTE=120

# ── Custom roles ───────────────────────────────────────────────────
# Custom roles per workspace, counted across BOTH scopes (workspace + project);
# the 8 built-in templates belong to no workspace and never count. Creating past it is a
# 409. A SPRAWL GUARD, NEVER A LICENCE CHECK — identical in dc and cloud, no profile
# override, no tier. The cap is EXACT, not approximate: creation counts under a row lock
# on the workspace, so concurrent creates queue rather than all passing the same check.
# Valid range 1–500 — an out-of-range value fails startup rather than being clamped.
# THERE IS NO "UNLIMITED" VALUE: 0 is out of range and fails startup, so an operator who
# wants no practical cap writes 500, the highest accepted number.
# To keep the default, leave the line COMMENTED OUT (as below) — not blank. "ROLES_MAX_
# CUSTOM_PER_WORKSPACE=" is an empty value, not an absent one, and binding empty to the
# app's primitive int aborts startup; only an absent variable falls back to 50.
# Note that 500 is not free: the roles list derives, for every role, which other roles it
# could assign — that comparison is quadratic in the number of same-scope roles, and every
# workspace member may call it.
#ROLES_MAX_CUSTOM_PER_WORKSPACE=50

# ── Project access for NEW workspaces ──────────────────────────────
# DEFAULT_PROJECT_ACCESS_MODE (app.workspace.default-project-access-mode) — the
# project-access mode a NEWLY CREATED workspace starts in:
#   OPEN   (default) everyone in the workspace can work in every project, through
#          each project's default role. Add someone to a project only to give them
#          a DIFFERENT role. This is the behaviour every existing workspace has.
#   STRICT only people added to a project can change anything in it. Everyone can
#          still SEE every project — STRICT narrows writes, never reads.
# It applies ONLY at creation. It never moves an existing workspace: change one
# from the UI (Workspace settings → General) or PATCH /api/workspaces/{ws}.
# Demo seeding creates its workspace through the same code path, so setting STRICT
# here gives you a strict demo workspace too — deliberately, with no bypass.
# Identical in dc and cloud: access modes are a product feature, not a plan feature.
# An unrecognised value ABORTS STARTUP rather than falling back — there is no third
# mode, and silently guessing at a security default is worse than not booting.
#DEFAULT_PROJECT_ACCESS_MODE=OPEN

# ── Bootstrap admin ────────────────────────────────────────────────
# The admin is seeded ONLY when BOTH email and password are set —
# a blank email skips seeding entirely (see DataSeeder).
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=SEED_ADMIN_PASSWORD
# Optional — defaults to "Admin".
#SEED_ADMIN_DISPLAY_NAME=Admin

# ── Public URL ─────────────────────────────────────────────────────
# APP_BASE_URL — used for email links, robots.txt/sitemap.xml and OG meta
# tags. MUST be the real public URL in prod (defaults to http://localhost:8080).
APP_BASE_URL=https://your-domain.example
# SITE_ADDRESS — the address(es) Caddy serves and gets Let's Encrypt certs for.
# Its host MUST match APP_BASE_URL's host. Comma-separate apex + www.
SITE_ADDRESS=your-domain.example, www.your-domain.example

# ── Email (SMTP) ───────────────────────────────────────────────────
# Defaults point at the dev MailHog (localhost:1025). In prod set a real
# SMTP server, otherwise email verification (which doubles as login) fails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=noreply@your-domain.example
# SMTP socket timeouts (ms) — a black-holed mail host fails a worker fast instead
# of hanging. Defaults are generous for real SMTP under normal load.
#MAIL_SMTP_CONNECT_TIMEOUT_MS=5000    # TCP connect timeout
#MAIL_SMTP_READ_TIMEOUT_MS=10000      # per-read (server response) timeout
#MAIL_SMTP_WRITE_TIMEOUT_MS=10000     # per-write (send) timeout

# ── Mail delivery reliability ──────────────────────────────────────
# Bounded async mail executor — mail can't starve other @Async work or spawn a
# thread-per-task under an SMTP stall (CallerRunsPolicy applies backpressure).
#MAIL_ASYNC_CORE_POOL=2               # steady-state mail-sender threads
#MAIL_ASYNC_MAX_POOL=5                # max mail-sender threads under load
#MAIL_ASYNC_QUEUE_CAPACITY=100        # queued mails before backpressure kicks in
# CRITICAL mail (verification + password reset) retries with backoff, then
# dead-letters to failed_email; invite mail stays best-effort (no retry).
#MAIL_CRITICAL_MAX_ATTEMPTS=3         # send attempts before dead-lettering
#MAIL_CRITICAL_RETRY_BACKOFF_MS=2000  # base backoff between retries (ms)

# ── Attachment storage ─────────────────────────────────────────────
# The default follows SPRING_PROFILES_ACTIVE: cloud -> s3, dc -> local
# (on-disk attachments_data volume). Uncomment STORAGE_TYPE only to
# override that per-model default (e.g. run Cloud on local disk).
#STORAGE_TYPE=s3
# Required only when the effective storage type is s3:
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
# S3 client timeouts (ms). Bound a hung S3 to <= api-call-ms total; read-ms is the
# ceiling per socket read (a large attachment streams over one socket). Only take
# effect when the effective storage type is s3; local FS ignores them.
#STORAGE_S3_CONNECT_TIMEOUT_MS=3000            # TCP connect timeout
#STORAGE_S3_READ_TIMEOUT_MS=20000              # per socket-read timeout
#STORAGE_S3_API_CALL_TIMEOUT_MS=30000          # total per-request budget (incl. retries)
#STORAGE_S3_API_CALL_ATTEMPT_TIMEOUT_MS=10000  # budget per single attempt

# ── Logging ────────────────────────────────────────────────────────
# Log levels. In the cloud/dc profiles the app emits one JSON object per
# line to stdout (for the observability pipeline); local/default stay readable.
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO

# ── Metrics / Actuator ─────────────────────────────────────────────
# The app exposes Prometheus metrics + health on a SEPARATE management port.
# Keep it INTERNAL — never add a compose `ports:` mapping and never proxy it
# through Caddy. Only in-network Prometheus should reach it.
MANAGEMENT_PORT=9090
MANAGEMENT_ENDPOINTS=health,prometheus,info
METRICS_EXPORT_ENABLED=true

# ── Observability stack (OPTIONAL) ─────────────────────────────────
# Only needed if you run the extra observability compose file:
#   docker compose -f docker-compose.prod.yml -f docker-compose.observability.yml up -d
# It adds Loki (logs) + Alloy (collector) + Grafana (dashboards). Nothing is
# exposed publicly; Grafana binds 127.0.0.1:3000 — reach it via an SSM
# port-forward (see docs/ops-prod-hardening.md §4).
GF_SECURITY_ADMIN_USER=admin
# Required when the observability stack runs (fail-fast otherwise):
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# How long Loki keeps logs (default 7 days):
LOKI_RETENTION_PERIOD=168h
# Prometheus metrics retention (whichever limit is hit first):
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
# postgres-exporter DB login. Least privilege: create a read-only pg_monitor
# role and set these (see the "Observability" section of docs/self-hosting.md for
# the CREATE ROLE SQL). If left unset, it falls back to the app DB_USERNAME/
# DB_PASSWORD so metrics still work out of the box.
#DB_MONITOR_USER=hamstrack_exporter
#DB_MONITOR_PASSWORD=
# Alerting: where Grafana emails alerts (AppDown, high error rate, disk, email
# failures, JVM heap…). Grafana's SMTP reuses your MAIL_* settings above. Leave
# empty to keep the alert rules evaluating without email delivery.
OBS_ALERT_EMAIL_TO=
