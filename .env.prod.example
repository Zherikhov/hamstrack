# Copy this file to `.env` on the server, next to docker-compose.prod.yml.
# docker compose auto-loads `.env` from the same directory.

# ── Container image ────────────────────────────────────────────────
# GitHub owner/org that hosts the ghcr.io/<owner>/hamstrack image.
# MUST be lowercase (GitHub image paths are case-sensitive).
GITHUB_OWNER=your-github-username

# ── Deployment model ───────────────────────────────────────────────
# cloud = hosted SaaS (S3 storage by default); dc = self-hosted (local
# disk by default). Storage/other per-model defaults come from this.
SPRING_PROFILES_ACTIVE=cloud

# ── Database ───────────────────────────────────────────────────────
DB_USERNAME=DB_USERNAME
DB_PASSWORD=DB_PASSWORD
# Connection-pool sizing (optional). Defaults: max 10, min-idle 5. Raise the max
# for higher concurrency, but keep (max × app replicas) under Postgres
# max_connections. With open-in-view=false connections are held only per
# transaction, so a small pool goes a long way.
#DB_POOL_MAX_SIZE=10
#DB_POOL_MIN_IDLE=5

# ── Security ───────────────────────────────────────────────────────
# Min 32 bytes or the app fails fast at startup.
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
# Access-token lifetime (ISO-8601 duration). Short by design — the refresh
# cookie renews it; a longer value widens the replay window for a leaked token.
#JWT_ACCESS_TOKEN_TTL=PT30M
# Auth rate-limiter: trust the rightmost X-Forwarded-For for per-IP keying.
# The bundled docker-compose.prod.yml forces this to true (traffic always comes
# through Caddy, which strips client-supplied XFF). Only override here if you run
# WITHOUT the bundled Caddy AND behind your own trusted proxy that strips XFF;
# leave it false (the app default) when the app port is directly reachable, or
# clients can spoof XFF to bypass the per-IP auth limit.
#RATE_LIMIT_TRUST_FORWARDED_FOR=true

# ── Uploads (optional) ─────────────────────────────────────────────
# Per-file business limit (enforced in-app) and the hard servlet ceiling.
# MAX_FILE_SIZE must stay <= MAX_UPLOAD_SIZE; match your proxy body limit to
# the ceiling. ALLOWED_EXTENSIONS is a case-insensitive comma-separated list.
#ATTACHMENT_MAX_FILE_SIZE=20MB
#ATTACHMENT_MAX_UPLOAD_SIZE=25MB
#ATTACHMENT_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,bmp,svg,pdf,txt,csv,log,md,json,doc,docx,xls,xlsx,ppt,pptx,zip

# ── Board ──────────────────────────────────────────────────────────
# Max issues a single board query returns — a guard against unbounded board
# loads on very large projects. Raise only if boards legitimately need more.
#BOARD_MAX_ISSUES=500

# ── Bootstrap admin ────────────────────────────────────────────────
# The admin is seeded ONLY when BOTH email and password are set —
# a blank email skips seeding entirely (see DataSeeder).
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=SEED_ADMIN_PASSWORD
# Optional — defaults to "Admin".
#SEED_ADMIN_DISPLAY_NAME=Admin

# ── Public URL ─────────────────────────────────────────────────────
# APP_BASE_URL — used for email links, robots.txt/sitemap.xml and OG meta
# tags. MUST be the real public URL in prod (defaults to http://localhost:8080).
APP_BASE_URL=https://your-domain.example
# SITE_ADDRESS — the address(es) Caddy serves and gets Let's Encrypt certs for.
# Its host MUST match APP_BASE_URL's host. Comma-separate apex + www.
SITE_ADDRESS=your-domain.example, www.your-domain.example

# ── Email (SMTP) ───────────────────────────────────────────────────
# Defaults point at the dev MailHog (localhost:1025). In prod set a real
# SMTP server, otherwise email verification (which doubles as login) fails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=noreply@your-domain.example
# SMTP socket timeouts (ms) — a black-holed mail host fails a worker fast instead
# of hanging. Defaults are generous for real SMTP under normal load.
#MAIL_SMTP_CONNECT_TIMEOUT_MS=5000    # TCP connect timeout
#MAIL_SMTP_READ_TIMEOUT_MS=10000      # per-read (server response) timeout
#MAIL_SMTP_WRITE_TIMEOUT_MS=10000     # per-write (send) timeout

# ── Mail delivery reliability ──────────────────────────────────────
# Bounded async mail executor — mail can't starve other @Async work or spawn a
# thread-per-task under an SMTP stall (CallerRunsPolicy applies backpressure).
#MAIL_ASYNC_CORE_POOL=2               # steady-state mail-sender threads
#MAIL_ASYNC_MAX_POOL=5                # max mail-sender threads under load
#MAIL_ASYNC_QUEUE_CAPACITY=100        # queued mails before backpressure kicks in
# CRITICAL mail (verification + password reset) retries with backoff, then
# dead-letters to failed_email; invite mail stays best-effort (no retry).
#MAIL_CRITICAL_MAX_ATTEMPTS=3         # send attempts before dead-lettering
#MAIL_CRITICAL_RETRY_BACKOFF_MS=2000  # base backoff between retries (ms)

# ── Attachment storage ─────────────────────────────────────────────
# The default follows SPRING_PROFILES_ACTIVE: cloud -> s3, dc -> local
# (on-disk attachments_data volume). Uncomment STORAGE_TYPE only to
# override that per-model default (e.g. run Cloud on local disk).
#STORAGE_TYPE=s3
# Required only when the effective storage type is s3:
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
# S3 client timeouts (ms). Bound a hung S3 to <= api-call-ms total; read-ms is the
# ceiling per socket read (a large attachment streams over one socket). Only take
# effect when the effective storage type is s3; local FS ignores them.
#STORAGE_S3_CONNECT_TIMEOUT_MS=3000            # TCP connect timeout
#STORAGE_S3_READ_TIMEOUT_MS=20000              # per socket-read timeout
#STORAGE_S3_API_CALL_TIMEOUT_MS=30000          # total per-request budget (incl. retries)
#STORAGE_S3_API_CALL_ATTEMPT_TIMEOUT_MS=10000  # budget per single attempt

# ── Logging ────────────────────────────────────────────────────────
# Log levels. In the cloud/dc profiles the app emits one JSON object per
# line to stdout (for the observability pipeline); local/default stay readable.
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO

# ── Metrics / Actuator ─────────────────────────────────────────────
# The app exposes Prometheus metrics + health on a SEPARATE management port.
# Keep it INTERNAL — never add a compose `ports:` mapping and never proxy it
# through Caddy. Only in-network Prometheus should reach it.
MANAGEMENT_PORT=9090
MANAGEMENT_ENDPOINTS=health,prometheus,info
METRICS_EXPORT_ENABLED=true

# ── Observability stack (OPTIONAL) ─────────────────────────────────
# Only needed if you run the extra observability compose file:
#   docker compose -f docker-compose.prod.yml -f docker-compose.observability.yml up -d
# It adds Loki (logs) + Alloy (collector) + Grafana (dashboards). Nothing is
# exposed publicly; Grafana binds 127.0.0.1:3000 — reach it via an SSM
# port-forward (see docs/ops-prod-hardening.md §4).
GF_SECURITY_ADMIN_USER=admin
# Required when the observability stack runs (fail-fast otherwise):
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# How long Loki keeps logs (default 7 days):
LOKI_RETENTION_PERIOD=168h
# Prometheus metrics retention (whichever limit is hit first):
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
# postgres-exporter DB login. Least privilege: create a read-only pg_monitor
# role and set these (see the "Observability" section of docs/self-hosting.md for
# the CREATE ROLE SQL). If left unset, it falls back to the app DB_USERNAME/
# DB_PASSWORD so metrics still work out of the box.
#DB_MONITOR_USER=hamstrack_exporter
#DB_MONITOR_PASSWORD=
# Alerting: where Grafana emails alerts (AppDown, high error rate, disk, email
# failures, JVM heap…). Grafana's SMTP reuses your MAIL_* settings above. Leave
# empty to keep the alert rules evaluating without email delivery.
OBS_ALERT_EMAIL_TO=
