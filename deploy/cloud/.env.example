# Copy this file to `.env` in this directory, fill every value under "Required"
# below, then follow the install steps in docs/cloud-mode.md.
#
# Nothing here has a working default on purpose: a filled-in sample in a public
# repository is a working credential. Each ${VAR:?} guard in docker-compose.yml fires
# on ABSENCE AND ON AN EMPTY VALUE - measured; that second half is the only reason an
# unedited copy of this file is refused at all, since every required line below ships
# empty. So `up` refuses and names the one value it wants; fill it, run again, and the
# next names itself. Treat it as a chain rather than a checklist - which one comes
# first is not fixed.
#
# A `$` in any value here is read by Compose as the start of a variable. Write `$$`
# for a literal one, or generate values that have none.

# ── Required ───────────────────────────────────────────────────────
# Any strong password you choose. Used twice from this one line: it seeds the
# PostgreSQL container and is what the app logs in with, so the two cannot drift.
#   openssl rand -base64 24
DB_PASSWORD=
# Token signing key, minimum 32 bytes. The app refuses to start on a shorter value,
# and on the placeholder values this project has published, by name.
#   openssl rand -base64 48
JWT_SECRET=
# Your own address. This becomes the first system administrator.
#
# NOTE, and it is the difference that matters in this model: on the CLOUD profile
# self-registration is OPEN, so this account is not the only way in - anybody who can
# reach the app can create their own. It is still the account that starts out as the
# system administrator.
SEED_ADMIN_EMAIL=
# A password you choose - not one from any documentation, and not this variable's own
# name. Max 72 UTF-8 BYTES (a BCrypt limit, not ours): 72 ASCII characters, ~36
# Cyrillic.
SEED_ADMIN_PASSWORD=
# MinIO's root credentials, which are also the app's S3 credentials - one pair, so
# they cannot disagree. The password must be at least 8 characters; MinIO refuses to
# start otherwise, and it refuses AFTER `up` has returned, so the symptom is a bucket
# job that never completes rather than an error on the command you typed.
#   openssl rand -base64 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Optional: where this instance is reached ───────────────────────
# Leave APP_BASE_URL on http://localhost:PORT until a TLS proxy is in front: with an
# https base the session cookie is Secure and will not survive plain HTTP.
#APP_BASE_URL=http://localhost:8080
# Host port for the app. Change it if 8080 is taken.
#APP_PORT=8080
# Bind address for that port. 0.0.0.0 (the default) publishes it on every interface.
#
# READ THIS ONE BEFORE PUTTING THE STACK ON A PUBLIC HOST. This model has OPEN
# REGISTRATION: a published port is a public sign-up page, not just a public login.
# Set APP_BIND=127.0.0.1 and reach it over an SSH tunnel while you are evaluating, or
# set PUBLIC_SIGNUP_ENABLED=false if you want the cloud model's storage and
# onboarding without its open door.
#APP_BIND=127.0.0.1
# MinIO's console (the web UI for looking at stored files). Loopback by default,
# deliberately: object storage does not belong on a public interface.
#MINIO_CONSOLE_PORT=9001
#MINIO_CONSOLE_BIND=127.0.0.1

# ── Optional: object storage ───────────────────────────────────────
# The bucket the app writes attachments to. Created for you by the minio-bucket
# service on first `up`; change the name here and it creates that one instead.
#STORAGE_S3_BUCKET=hamstrack-attachments
# The SDK requires a region even where the store ignores it, which MinIO does.
#STORAGE_S3_REGION=us-east-1

# ── Optional: which build runs ─────────────────────────────────────
# The release LINE, so patch releases arrive on `docker compose pull`. Never `latest`:
# it moves on every main build. An exact version pins harder and never moves.
#APP_IMAGE_TAG=0.18
# The two MinIO images this stack runs, pinned the same way and for the same reason:
# an unpinned object store is a store that changes under your data on a `pull`. These
# are release-dated tags rather than a line, so they never move on their own - raise
# them deliberately, and read MinIO's own upgrade notes when you do.
#MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
#MINIO_CLIENT_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z

# ── Optional: profile defaults you may want to move ────────────────
# These are the defaults this stack runs with, written out so you can see them and
# change them. Every one is a plain variable - a profile only chooses the default.
#
# One of them is not the cloud profile's at all, and it is the one that matters most
# here: PUBLIC_SIGNUP_ENABLED is declared only by the `dc` profile, so open signup is
# the BASE default in application.properties. This stack gets it by inheritance rather
# than by decision, and so would a run with no profile at all.
#PUBLIC_SIGNUP_ENABLED=true
#ONBOARDING_ENABLED=true
# 10GB per workspace. The cloud profile's reason for that number is an S3 bill, which
# is NOT what you have: on this stack the bytes land in the `minio_data` volume on this
# host's disk, and there is no total cap across workspaces - so with open signup left
# on, the ceiling on your disk is 10GB times however many workspaces get created.
# Watch the disk, lower this, or close signup.
#STORAGE_QUOTA_WORKSPACE_BYTES=10GB
# The CSP report sink is ON here (it is off on dc), so this instance exposes one
# unauthenticated endpoint that collects browser violation reports. Its per-sender
# budget keys on the client address, so BEHIND A PROXY set the next line as well or
# every report arrives from the proxy and the per-sender bound degrades to a single
# instance-wide one. Set that next line only if the proxy OVERWRITES a client-supplied
# X-Forwarded-For (the bundled Caddy does): if it passes one through, trusting it hands
# every caller their own choice of identity - docs/self-hosting.md pairs the two.
#CSP_REPORT_SINK_ENABLED=true
#RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ── Optional: email (SMTP) ─────────────────────────────────────────
# NOT REQUIRED TO INSTALL - but it means more here than it does for a self-hosted
# install. With open registration on and no SMTP, a person who signs up cannot
# complete verification, so in practice you either configure mail or turn signup off
# and add people yourself in /admin.
# These lines are COMMENTED rather than empty on purpose: an empty `MAIL_HOST=` is
# delivered to the container as an empty string and overrides the application's own
# default, while a commented line delivers nothing and lets the default stand.
#
# MAIL_SMTP_AUTH and MAIL_STARTTLS both default to FALSE. Filling in a username and
# password without them authenticates against nothing - the app connects, does not
# offer the credentials, and the provider refuses or silently drops the mail. Nearly
# every real SMTP provider wants both on; MailHog wants neither.
#MAIL_HOST=
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS=true
#MAIL_FROM=

# ── Optional: host sizing ──────────────────────────────────────────
# The app limit is not a tuning knob you can ignore: the image sizes its heap at 50% of
# the CONTAINER limit, so removing it sizes the heap against host RAM.
#APP_MEMORY_LIMIT=1g
#POSTGRES_MEMORY_LIMIT=512m
#MINIO_MEMORY_LIMIT=512m
# The one-shot jobs (preflight, minio-bucket) share one ceiling: same image, same
# two seconds of work.
#MINIO_CLIENT_MEMORY_LIMIT=128m
# PostgreSQL's memory dials. These values are the ones the stack already passes, so a
# line changes nothing until you edit it - they are here so the dial is in this file
# when you want it, rather than a literal in the compose file your .env cannot reach.
#POSTGRES_SHARED_BUFFERS=128MB
#POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
#POSTGRES_WORK_MEM=4MB
# Docker gives every container a 64 MB /dev/shm and PostgreSQL's parallel workers size
# their shared segments from work_mem, so raise this when you raise POSTGRES_WORK_MEM.
#POSTGRES_SHM_SIZE=64m
# Seconds between SIGTERM and SIGKILL. The app spends up to 15s flushing queued mail at
# shutdown and refuses to start if that would not fit.
#APP_STOP_GRACE_SECONDS=30

# Do NOT set SPRING_PROFILES_ACTIVE here. This stack is the cloud model and
# docker-compose.yml fixes the profile as a literal, which wins over this file.
