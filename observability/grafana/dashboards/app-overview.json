{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "App Overview",
  "uid": "hamstrack-app",
  "tags": ["hamstrack", "app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_count{job=\"hamstrack-app\"}[5m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error rate %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_count{job=\"hamstrack-app\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"hamstrack-app\"}[5m])) * 100", "legendFormat": "5xx %" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (p95 / p99, seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"hamstrack-app\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"hamstrack-app\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_requests_seconds_count{job=\"hamstrack-app\"}[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Slowest endpoints (avg latency, top 5)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "topk(5, sum(rate(http_server_requests_seconds_sum{job=\"hamstrack-app\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"hamstrack-app\"}[5m])) by (uri))", "legendFormat": "{{uri}}" }
      ]
    }
  ]
}
