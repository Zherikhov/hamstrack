[Unit]
Description=Hamstrack database backup (HD-187)
Documentation=https://github.com/Zherikhov/hamstrack/blob/main/docs/design/production-backups-proposal.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/hamstrack/backup.env
ExecStart=/usr/local/bin/hamstrack-backup

# The metric of last resort. The script writes its .prom from an EXIT trap, and a trap does
# not run for SIGKILL — a cgroup OOM kill, `systemctl kill -s KILL`, or the ungraceful half
# of the timeout below. In those cases the file would keep the PREVIOUS run's
# `last_status 1`, BackupRunFailed would stay silent, and the only remaining signal would be
# BackupStale 26 hours later. systemd outlives a SIGKILL of the main process, so it stamps
# the failure itself. (This corrects spec §10 case 8, which claimed "unit fails → metrics
# stale → alert": the metric is not stale after a kill, it is confidently wrong.)
#
# LAST RESORT IS THE WHOLE POINT — it fires on ANY non-success result, including an ordinary
# `exit 1`, and what it can say is coarse: both stages failed, size 0. On the flagship
# failure (dump fine, upload failed) the trap's answer is truthful and specific, so the
# script stands down here when its own EXIT trap already published for this run — it
# compares a marker cleanup writes as its last act against the recorded run start. Without
# that, this line silently inverted the first move of an incident: "failed at stage dump"
# while a valid dump sat in /var/backups/hamstrack.
ExecStopPost=/usr/local/bin/hamstrack-backup --stop-post

# Type=oneshot has NO start timeout by default. A pg_dump blocked behind an ACCESS
# EXCLUSIVE lock, or a wedged dockerd, would otherwise run forever holding the lock file —
# and every later firing would take the `flock -n` loser branch, which exits 0 without
# touching the metrics, while the unit sat in `active (start)` rather than failed. 30
# minutes is ~60x the expected run. Exceeding it sends SIGTERM, which the script traps and
# turns into an ordinary exit — so cleanup runs, the partial dump is removed and the metrics
# say the run failed. (Bash runs no EXIT trap for an untrapped fatal signal, so without that
# trap the timeout left a partial, unverified dump behind stale metrics.)
TimeoutStartSec=1800

# What this cgroup actually bounds, which is NOT the dump: `docker exec` runs pg_dump inside
# the POSTGRES CONTAINER's cgroup, and that container declares no mem_limit at all. What
# lives here is bash, the docker CLI, md5sum and the AWS CLI — and AWS CLI v2 is a
# PyInstaller bundle with a 120-180 MB baseline RSS, so the old MemoryHigh=192M put the one
# process that needs memory into continuous reclaim. These numbers are still a guess:
# measure with `systemctl show -p MemoryPeak hamstrack-backup.service` after the first
# manual run (runbook §6.3 step d) and set them from that. The box has 1909 MB and no swap
# (docs/ops-prod-hardening.md §5), so a ceiling here is still worth having: exceeding
# MemoryMax fails the unit, which is loud, contained, and not an outage.
MemoryHigh=384M
MemoryMax=512M
TasksMax=64

# Not set, and deliberately: the default TimeoutStopSec (90s in systemd's own default) is
# what separates the SIGTERM above from the SIGKILL that follows. The script traps TERM and
# exits through its normal cleanup, so the graceful half publishes real metrics and removes
# a partial dump; only if that cleanup itself hangs does SIGKILL land, and ExecStopPost is
# what covers that. Setting TimeoutStopSec=0 would remove the graceful half entirely.
#TimeoutStopSec=

# A runaway write dies instead of filling the volume PostgreSQL lives on. Generous against
# an expected dump of a few MB; revisit against hamstrack_backup_size_bytes once it has
# history. Exceeding it is SIGXFSZ, which ExecStopPost above turns into a reported failure.
LimitFSIZE=2G

# Be the first thing to yield: this runs while the product is meant to be serving.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle

# Honest accounting of the sandbox below: this unit talks to the DOCKER SOCKET, which is
# root-equivalent by construction — anything that can run this script can start a container
# with the host filesystem mounted. None of these settings reduce an attacker's capability;
# they reduce the blast radius of a MISTAKE (a typo'd path, a runaway write, a rogue
# child), and they make an unexpected write show up as an error instead of a modified host.
NoNewPrivileges=yes
PrivateTmp=yes
# read-only, NOT yes: `yes` hides /root/.aws, which is invisible on Cloud (the instance
# role comes from IMDS) and fatal for a self-hoster using MinIO/B2 keys — and a hand-run
# outside systemd would still work, which is the worst diagnostic shape there is.
ProtectHome=read-only
# THE DOCKER CONFIG DIRECTORY IS THE OTHER HALF OF THAT LINE, and this unit deliberately does
# NOT do what hamstrack-config-drift.service had to do (measured 2026-09-07). That unit runs
# under ProtectHome=YES, where /root is replaced by an empty inaccessible mount, so the CLI's
# `mkdir /root/.docker` was EROFS every time and `docker compose up -d --dry-run` could never
# run at all; it now points DOCKER_CONFIG at a RuntimeDirectory. Read-only is a different
# state, and the difference is what decides this file:
#   * this script does invoke the CLI in ways that consult that directory — `docker compose
#     -f … ps -q` as well as `docker exec` — so the question is real here too;
#   * under read-only, /root/.docker is VISIBLE, and `MkdirAll` on a directory that already
#     exists succeeds without writing — so once it is there the CLI is satisfied by what it
#     finds, whichever verb consults it (`up` is the one that wanted to WRITE it, and this
#     script never runs `up`). That covers today. What covers the days before it existed is a
#     NEGATIVE RESULT, and it is bounded rather than general: this unit ran on 2026-08-27,
#     08-28 and 08-29 with /root/.docker absent (it was created 08-30) and NO RUN HAS EVER
#     FAILED THAT WAY — three nights, on whatever docker CLI and Compose those days' box
#     carried, which nothing recorded (its Compose generation is first written down as of
#     2026-09-05). It is not a claim about every code path in every version, which is why the
#     residue below is named rather than closed;
#   * and DOCKER_CONFIG is not a free redirect: it also moves the CLI's per-user plugin
#     directory ($DOCKER_CONFIG/cli-plugins). On a box where `docker compose` was installed
#     the manual way — into ~/.docker/cli-plugins, which nothing in our docs forbids —
#     setting it here turns a working backup into "'compose' is not a docker command". The
#     drift unit pays none of that cost because ProtectHome=yes had already emptied that
#     directory; this one would pay all of it, and the price would be A BACKUP THAT DOES NOT
#     HAPPEN.
# SO THE RESIDUE IS NAMED RATHER THAN CLOSED: correctness here is contingent on the host's
# /root/.docker, not guaranteed by this file. If this unit ever fails with a write under
# /root — `mkdir /root/.docker: read-only file system` or the same on a file inside it — that
# is this note coming true, and the repair is the drift unit's (RuntimeDirectory= +
# Environment=DOCKER_CONFIG=/run/…) plus one check first — ask the CLI the question you mean
# rather than guessing at directories:
#     sudo DOCKER_CONFIG="$(mktemp -d)" docker compose version
# must print a version. That is the redirect itself, rehearsed: it proves the plugin resolves
# with the per-user directory pointed away. An `ls` of a couple of system cli-plugins paths
# does not — there are at least four (/usr/libexec, /usr/local/libexec, /usr/lib,
# /usr/local/lib .../docker/cli-plugins) and a list that misses one answers "not there" about a
# plugin that is.
ProtectKernelTunables=yes
ProtectControlGroups=yes
UMask=0077
# Everything read-only except the four directories the job writes. Two ways to trip over
# this, both with a one-line remedy:
#   * every path listed here must EXIST before the unit starts, or systemd refuses to set
#     up the namespace and the unit fails before the script runs. The install steps create
#     all three (docs/self-hosting.md#on-a-schedule, ops-prod-hardening.md §6.3) — including
#     the textfile directory, which is created even if you do not run the observability
#     stack, because the script always publishes its metrics.
#   * if you repoint BACKUP_LOCAL_DIR / BACKUP_STATE_DIR / BACKUP_TEXTFILE_DIR in
#     backup.env, add the new path here with a drop-in (`systemctl edit
#     hamstrack-backup.service`) or the run fails with "Read-only file system".
# /run/lock is /var/lock (the flock file), and always exists.
ProtectSystem=strict
ReadWritePaths=/var/backups/hamstrack /var/lib/hamstrack-backup /var/lib/node_exporter/textfile_collector /run/lock
