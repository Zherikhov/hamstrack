[Unit]
Description=Hamstrack configuration drift check (HD-199)
Documentation=https://github.com/Zherikhov/hamstrack/blob/main/docs/design/config-delivery-proposal.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hamstrack-config-drift

# The box's own knobs, and the ONLY supported way to set them. COMPOSE_FILES is the one
# that matters: a deployment that runs no observability stack must narrow the set, or the
# `containers` scope compares against a compose file that is not there and reports
# containers=1 for ever about a stack that is entirely healthy. Without this line the
# variable reaches only the hand-run path — `COMPOSE_FILES=… hamstrack-config-drift` — and
# the hourly timer, which is what actually publishes the metric, never sees it.
# An EnvironmentFile rather than an inline Environment= because THIS FILE IS COMPARED
# BYTE-FOR-BYTE with the synced copy (the `installed-ops` drift scope): editing the
# installed unit to add a variable would show as permanent drift on every check. The
# leading `-` makes the file optional, so a box that needs nothing sets nothing.
# Also read: CONFIG_DRIFT_TEXTFILE_DIR, CONFIG_DRIFT_UNIT_DIR, CONFIG_DRIFT_BIN_DIR.
EnvironmentFile=-/etc/hamstrack/drift.env

# Bounded because it runs hourly beside a production app on a 1909 MB box with no swap.
# What lives in this cgroup is bash, sha256sum, find and the docker CLI — no dump, no
# upload, no Python bundle — so this is an order of magnitude below the backup job's
# ceiling. Exceeding it fails the unit, which is loud, contained, and not an outage.
# Measure it the way ops-prod-hardening.md §6.3 step f measures the backup unit: read the
# cgroup WHILE IT RUNS. `systemctl show -p MemoryPeak` does NOT exist here (the property
# arrived in systemd 253; Amazon Linux 2023 ships 252, and `show` returns 0 while silently
# omitting it).
MemoryHigh=96M
MemoryMax=128M
TasksMax=32

# A check that cannot finish must not hold the box's attention: it publishes its metrics
# from an EXIT trap, and SIGTERM is trapped like any other exit, so a timeout still leaves
# a truthful reading rather than yesterday's.
TimeoutStartSec=300

# Be the first thing to yield — this runs while the product is meant to be serving.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle

# Same honest accounting as hamstrack-backup.service: this unit talks to the DOCKER
# SOCKET, which is root-equivalent by construction. None of the settings below reduce an
# attacker's capability; they bound the blast radius of a MISTAKE and make an unexpected
# write show up as an error instead of a modified host.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
UMask=0022
# Everything read-only except the one directory this job writes. The path must EXIST before
# the unit starts or systemd refuses to set up the namespace and the unit fails before the
# script runs — the install step creates it, and so does the backup job's.
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector

# THE DOCKER CLI NEEDS A CONFIG DIRECTORY IT CAN WRITE, AND UNDER THIS SANDBOX $HOME/.docker
# IS NOT ONE. ProtectHome=yes above replaces /root with an empty, inaccessible mount and
# ProtectSystem=strict makes what is left read-only, so the `containers` scope's whole
# question — `docker compose up -d --dry-run` — died before it was asked:
#     mkdir /root/.docker: read-only file system
# and the scope published "this check could not ask", which ConfigDrift reports as critical
# after 30 m. It did that against a HEALTHY box: the same command by hand printed all ten
# containers Running and exited 0, because a hand run has the real /root. Measured
# 2026-09-07, the morning the timer was first installed — until then the only thing that had
# ever run this check was apply-config.sh at the tail of a deploy, as plain root with no
# sandbox, so the `containers` scope had never once executed under the unit that is supposed
# to run it hourly. A CHECK THAT CANNOT CLEAR GETS MUTED, which is the failure HD-221 fixed
# once already, arriving here through the sandbox instead of through the oracle.
#
# WHAT THIS ADDS TO THE WRITABLE SURFACE IS ONE TMPFS DIRECTORY: /run/hamstrack-config-drift,
# 0700 root, created by systemd before the run and DELETED when the unit stops. Nothing under
# /root is unhidden and no persistent path becomes writable. The CLI sees exactly what
# ProtectHome=yes already gave it — an empty config directory — except that it can now write
# in it, so this is the smallest thing that answers the error: it takes nothing away and
# leaves nothing behind. `docker compose` itself is unaffected, and that is a property of the
# empty directory rather than of luck: the plugin resolves from a SYSTEM cli-plugins
# directory here. That is measured rather than argued: this script asks Compose to resolve the
# configuration (`docker compose … config --services`, hamstrack-config-drift.sh:436) BEFORE it
# asks for the plan (:456), and a failure there returns early under a DIFFERENT journal line
# (:437). What production published was the line-481 message, so `config --services` had
# already exited 0 inside this namespace, with an empty /root and no per-user cli-plugins
# directory for the plugin to have come from.
#
# THE SHORTER FIXES, ALL REJECTED:
#   * ProtectHome=read-only (what hamstrack-backup.service uses) hands this unit — which
#     holds the DOCKER SOCKET, i.e. root-equivalence, see the note above — the whole of
#     /root as well: /root/.aws, any ssh key, any operator history. And it does not reliably
#     fix it: a read-only /root works only while /root/.docker ALREADY EXISTS (on this box it
#     does, drwx------ root root, created 2026-08-30 by nothing that manages it) and fails
#     with the identical EROFS the first time the CLI has to create or write it. A repair
#     whose correctness rests on an unmanaged host directory is the shape of the defect, not
#     of the fix.
#   * ReadWritePaths=/root/.docker makes a PERSISTENT root-owned host directory writable to
#     the socket holder, and — see the note on ProtectSystem below — every path listed there
#     must EXIST before the unit starts or systemd refuses to set up the namespace and the
#     unit fails before the script runs. That makes the unit's ability to START depend on a
#     directory no install step creates. (It is also inert while ProtectHome=yes overmounts
#     /root, so in practice it is the rejected line above plus a persistent write.)
#   * DOCKER_CONFIG under PrivateTmp's /tmp needs no new mount at all, and was rejected for
#     being invisible: that /tmp is mode 1777 and shared with everything else in the cgroup,
#     and it would tie this unit's correctness to PrivateTmp= staying on with nothing saying
#     so.
#   * Setting DOCKER_CONFIG inside the SCRIPT was rejected because it would follow the script
#     to the hand-run and deploy paths, where /root IS available and redirecting the CLI away
#     from the operator's own config and docker context would be a regression — and because
#     the next author of a unit like this one copies the unit, not the script.
#
# An inline Environment= rather than drift.env above, which does not contradict the note
# there: what belongs in that file is a BOX's setting, and this is the unit's own, shipped
# with it and identical everywhere. An operator who must point the CLI elsewhere (a docker
# context of their own) can still do it from drift.env — an EnvironmentFile always overrides
# Environment= — but only at A TARGET OUTSIDE $HOME, which then owes a ReadWritePaths=
# drop-in. A target under /root cannot be reached from here at all: ProtectHome=yes overmounts
# it, which is what makes a ReadWritePaths= for it inert (the rejected line above).
#
# THE PATH IS SPELLED OUT INSTEAD OF %t/… ON PURPOSE. systemd copies an UNKNOWN specifier
# through verbatim, so on a build that does not know %t the CLI is handed the RELATIVE path
# `%t/hamstrack-config-drift`, resolved against WorkingDirectory (unset → /) — and a build that
# old does not honour ProtectSystem=strict either, so / is writable and the mkdir SUCCEEDS: the
# check goes green while creating a directory literally named `%t` at the root of the host,
# which nothing ever removes. This is a system unit (no [Install], uid 0), so %t is always /run and
# the literal is exact — and it removes a silent failure for free.
#
# THE FLOOR THIS LEANS ON IS SYSTEMD 235 — not the age of RuntimeDirectory= or of
# ProtectSystem=strict, but the ExecDirectory rework that makes RuntimeDirectory= paths EXEMPT
# from ProtectSystem=strict, i.e. mounted writable inside the namespace. Below it this unit
# starts and the directory is read-only, which is the original error at a new path. Amazon
# Linux 2023 ships systemd 252.
RuntimeDirectory=hamstrack-config-drift
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/hamstrack-config-drift

# No [Install] section, deliberately — like hamstrack-backup.service. This unit is started
# by its .timer; `systemctl enable` on the SERVICE would be a second, boot-time trigger
# nobody asked for. Enable the timer.
