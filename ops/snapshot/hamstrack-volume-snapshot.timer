[Unit]
Description=Hourly Hamstrack root-volume snapshot age check

[Timer]
# Hourly, although the answer only changes once a day, and it buys two things: the volume
# IDENTITY is re-resolved often, so a root-volume replacement is noticed within an hour
# rather than within a day, and the stale-check threshold can reuse the drift check's 3 h
# convention instead of inventing a second one. Two EC2 Describe calls an hour are free,
# unbillable and orders of magnitude below any throttle.
OnCalendar=hourly
# Spread it off the top of the hour, away from the scrape and away from anything else that
# runs on a round number.
RandomizedDelaySec=300
# If the box was down, check at the next boot rather than skipping the window.
# VolumeSnapshotCheckStale has `for: 1h` on a 3 h threshold, so one missed hour never turns
# into a missed alert.
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
