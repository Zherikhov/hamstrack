<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.hamstrack</groupId>
    <artifactId>hamstrack</artifactId>
    <!-- Placeholder — the real version is injected at image build time from the
         git release tag (APP_VERSION build-arg → versions:set). Do not hand-bump. -->
    <version>0.0.0-DEV</version>
    <name>hamstrack</name>
    <description>Hamstrack — source-available task tracker with AI agent support</description>
    <url/>
    <licenses>
        <license>
            <name>Elastic License 2.0</name>
            <url>https://www.elastic.co/licensing/elastic-license</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <awssdk.version>2.47.3</awssdk.version>
        <!-- HD-94: -Dfrontend.skip=true skips node install + npm install + npm run build
             — and, since HD-242, `npm test` too — for a fast backend-only loop
             (`mvnw test`). Keep the default false: a plain `mvnw package` / CI's
             `./mvnw -B verify` MUST still build the SPA into src/main/resources/static,
             which is what ships inside the JAR, and MUST still run the frontend suite,
             which nothing else does. Note the two off-switches are not the same switch:
             this one drops the SPA from the artifact, `-DskipTests` leaves the build
             intact and drops only the test executions (surefire's and npm-test's). -->
        <frontend.skip>false</frontend.skip>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <!-- version managed by the Spring Boot BOM -->
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <!-- version managed by the Spring Boot BOM (the <parent>); do NOT pin -->
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- Apache5 sync HTTP client — already pulled transitively by :s3 (runtime).
             Declared explicitly (version managed by the AWS BOM) so S3FileStorage can
             reference Apache5HttpClient.builder() at compile time to set the HD-76
             connect/socket timeouts. Not a NEW http client — the one already resolved. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache5-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- HD-265. Surefire already puts the JUnit Platform launcher on the test JVM's classpath
             at runtime, so nothing needed it DECLARED until a TestExecutionListener had to compile
             against it (ExecutedTestClassRecorder — the half of the suite-coverage guard that can
             see what actually ran). Declaring it is the setup JUnit documents for exactly this, and
             it is the same artifact Surefire would have injected, not a second one: version managed
             by the JUnit BOM the Spring Boot BOM imports, so do NOT pin it here. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>src/main/frontend</workingDirectory>
                    <installDirectory>target</installDirectory>
                    <!-- Every goal of this plugin (install-node-and-npm, npm) declares its
                         own editable `skip` parameter, so one plugin-level binding covers
                         all four executions below, including npm-test (HD-242). -->
                    <skip>${frontend.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>v22.13.0</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <!-- `ci`, not `install` (HD-28 R1 round 2). `npm install` is free to
                             RESOLVE a dependency to something the lockfile does not name — it
                             updates package-lock.json to match package.json rather than the
                             other way round — so a build could ship a transitive version
                             nobody reviewed. `npm ci` installs the lockfile exactly and fails
                             if package.json and the lock disagree. Every one of those packages
                             runs code at build time; the reports work alone brought in 36 more
                             (recharts pulls the Redux stack via victory-vendor). It is also
                             the faster of the two for a clean CI checkout. NOTE: `ci` deletes
                             node_modules first, so it needs the lockfile committed and in
                             sync — that is the point. -->
                        <configuration><arguments>ci</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                    <!-- HD-242: the frontend suite runs inside `mvn verify`, not beside it.

                         Before this execution existed, `npm test` ran on no automated path
                         at all. CI's only command is `./mvnw -B verify`, and the three
                         executions above install Node, install the lockfile and run
                         `tsc -b && vite build` — a type error broke the build, a behavioural
                         regression did not. So `src/licensing.test.ts` — the HD-194 seal that
                         exists to go red when a retired licence claim comes back — could only
                         ever fail a person who remembered to type the command. A guard CI
                         never runs is documentation.

                         WHY A FOURTH EXECUTION AND NOT A SECOND CI STEP. A step in build.yml
                         would keep local builds ~40s faster, and would have been wrong for
                         the same reason this hid for a year: it leaves `verify` an incomplete
                         gate that everyone treats as a complete one. Someone verifying a
                         release locally, the Dockerfile, a future workflow — each would have
                         to remember the second mechanism. Here there is one: whatever runs
                         the lifecycle runs the suite, and `-Dfrontend.skip=true` (HD-94)
                         switches all four executions off together, by construction rather
                         than by a second flag that has to be kept in sync.

                         WHY THE `test` PHASE SPECIFICALLY. AbstractFrontendMojo honours
                         `-DskipTests` ONLY for an execution bound to `test` or
                         `integration-test` (`skipTestPhase()`; verified against 1.15.1) — so
                         this binding gives the frontend suite the same off-switch as
                         surefire, for free. That matters immediately: the Dockerfile builds
                         with `clean package -DskipTests` because build-and-test already
                         gated the tree, and the image build therefore does NOT pay this cost
                         a third time per pipeline. Bind this to `process-test-classes` to
                         make it run before surefire and you silently lose that.

                         The price of that choice, so it is not a surprise: within the `test`
                         phase the default-lifecycle binding goes first, so surefire runs the
                         whole backend suite BEFORE this executes (verified in the build log).
                         Frontend feedback therefore arrives last on a full run — use `npm
                         test` in src/main/frontend while iterating, and keep the shared
                         off-switch here.

                         COST, measured on the 12-core dev box on 2026-09-04 (1166 tests,
                         68 files). Three ways, because one number would have been a lie:

                           41s / 55s   `npm test` on its own, two runs, same tree
                           69s         the execution alone through Maven
                                       (`mvnw frontend:npm@npm-test`, ~6s of it Maven start)
                           +48s        the lifecycle delta: `mvnw test -DskipTests` (1:32)
                                       against `mvnw test -Dmaven.test.skip.exec=true`
                                       (2:20) — same tree, same npm ci, same vite build,
                                       the ONLY difference being this execution

                         So budget ~45-70s on a non-skipped build. Note the spread between
                         two runs of the IDENTICAL command (41s vs 55s) is wider than any
                         difference the wiring makes: this cost is a property of the machine,
                         not of the config, which is exactly what HD-240 found one layer down
                         and exactly why the survey below reports percentages.

                         THE FAILURE MODE THIS STEP HAS. Not "the tests break" — that is the
                         step working. It is a step that runs, prints, exits 0 and asserted
                         NOTHING, because the include glob stopped matching (a directory
                         rename, a `dir` flag added to the script, a `passWithNoTests`
                         borrowed from someone's CI snippet). `vitest run` exits 1 on an empty
                         match, so today the build goes red — verified, not assumed: pointing
                         `include` at a non-existent directory produced `No test files found,
                         exiting with code 1` and a Maven BUILD FAILURE (HD-242, 2026-09-04).
                         Keep that property: `passWithNoTests`, in flag or config form,
                         appears nowhere in this repo and must not appear in vitest.config.ts,
                         in `package.json`'s `test` script, or here. Note this one guard
                         cannot live in the suite — a test asserting "the suite is non-empty"
                         is not collected when the suite is empty. What a reader checks
                         instead is the count vitest prints above its result (`Test Files … /
                         Tests …`): a run that suddenly asserts an order of magnitude less is
                         visible there and nowhere else, which is why the whole npm output is
                         left on INFO rather than quieted.

                         WHAT MAKES IT AFFORDABLE: HD-240. An unmargined suite wired into
                         `verify` is worse than no wiring, because the cheapest response to a
                         suite that goes red for reasons that are not about the product is to
                         mute it — which returns us to exactly here, plus a step everyone
                         believes is protecting them. HD-240 sized `testTimeout` against the
                         load factor rather than the standalone cost and left a standing
                         margin survey (`src/test/marginReporter.ts`) that prints the five
                         slowest tests as a PERCENTAGE of the bound after every full run. It
                         reaches the Maven log because the plugin streams npm's stdout at
                         INFO — read it, don't mute it. -->
                    <execution>
                        <id>npm-test</id>
                        <goals><goal>npm</goal></goals>
                        <phase>test</phase>
                        <configuration><arguments>run test</arguments></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Generates META-INF/build-info.properties → Spring exposes it
                         as a BuildProperties bean; /api/meta serves the version from it -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      Bare `assert` statements run ONLY when the JVM is started with -ea, and
                      much of this suite is written with them: those checks have an opinion at
                      all because Surefire enables assertions by default. That default is the
                      problem — it is load-bearing and this build file never said so. A future
                      Surefire default, or an enableAssertions=false added here for an
                      unrelated reason, would turn every one of those checks into a silent
                      no-op and NOT ONE TEST WOULD TURN RED. This line states the default, so
                      that losing it has to be a deliberate edit to this block rather than a
                      side effect of someone else's change.

                      IT IS A FLOOR, NOT A FIX, and it reaches only the Maven run. An IDE
                      builds its own command line: neither IntelliJ nor VS Code passes -ea, so
                      a developer running one class from the editor — which is how anyone
                      actually works on a failing test — watches it pass on assertions that
                      never executed. Do not read this line as the problem being handled. The
                      remedy is the ongoing conversion of bare `assert` to real assertion
                      calls (HD-164), which hold whoever runs them and however they are run;
                      until a class is converted, only CI is really checking it.
                    -->
                    <enableAssertions>true</enableAssertions>

                    <!--
                      TEST-ONLY connection-pool cap.

                      The suite runs many @SpringBootTest classes and every distinct
                      context configuration (each `properties = …` override spawns one)
                      is CACHED for the whole JVM, holding its own Hikari pool. At the
                      production default (maximum-pool-size=10, minimum-idle=5) roughly a
                      dozen cached contexts is already 60+ idle connections, and the suite
                      hit PostgreSQL's default `max_connections = 100` ceiling: two runs
                      died with `FATAL: sorry, too many clients already` inside
                      WorkspaceCreationTest — a class that touches none of the new code and
                      fails at CONTEXT STARTUP, so the symptom looks nothing like the cause.
                      The local container was raised to max_connections=300 as a stopgap,
                      but CI Postgres service containers default to 100, so the cap has to
                      live in the build.

                      4 connections is ample: tests are single-threaded per class
                      (forkCount defaults to 1, no parallel execution) and
                      spring.jpa.open-in-view=false means a connection is held only for the
                      duration of a transaction. minimum-idle=0 lets an idle cached
                      context's pool drain back to zero instead of parking 5 connections
                      each for the rest of the run.

                      System properties sit ABOVE application.properties and BELOW
                      @SpringBootTest(properties = …) / @TestPropertySource in Spring's
                      precedence order, so this overrides the production defaults without
                      taking anything away from a test that deliberately tunes the pool.

                      THE TWO EXPENSIVE-READ NUMBERS ARE HERE BECAUSE THE POOL CAP IS
                      (HD-182), and they are not a policy of their own. They are PINNED
                      rather than required: the shipped default of both is -1, "derive from
                      the pool", so a pool of 4 with neither set derives 2 and boots — the
                      suite would not fail without these lines. What they buy is that every
                      context runs the SAME two numbers whatever a class does to its pool,
                      and that the numbers are small enough to be a LEAK DETECTOR. (This
                      comment used to justify them by "the production default share is 6",
                      which stopped being true when the literal default became a derivation.)
                      2 and 2 keep the WARN quiet (the soft rule is 60% of the pool) and
                      make the bound a LEAK DETECTOR: it stays on even where
                      app.rate-limit.enabled=false, which is most contexts, so a permit that
                      is acquired and never released makes the THIRD sequential expensive
                      request in that context fail loudly instead of draining capacity in
                      silence. A class that needs different numbers overrides them in its own
                      @SpringBootTest(properties = …), which sits above this.
                    -->
                    <systemPropertyVariables>
                        <!--
                          HD-265: the identity of THIS Maven session, and where to write it down.

                          ExecutedTestClassRecorder (a ServiceLoader-registered JUnit Platform
                          listener) records the test classes this fork actually executed into
                          target/test-run-record/, and the antrun step below compares that record
                          against src/test/java. The record has to be per-run: target/surefire-reports
                          is cumulative and is never cleaned, so on the day HD-265 was filed it held
                          more reports than the tree held classes, two of them naming classes deleted
                          weeks earlier — anything derived from it counts history rather than this
                          run, which is the failure being guarded against, dressed as the guard.
                          Freshness is therefore an IDENTITY, not a timestamp comparison:
                          ${maven.build.timestamp} is fixed for the whole session and both halves are
                          handed the same value, so the reader accepts only files this run wrote and
                          ignores every leftover (an earlier run, an IDE run, a crashed run) on sight.

                          Losing either line is silent in the only way that matters: the suite still
                          runs and still passes, and the step below can no longer tell how much of it
                          ran — which is why it treats a missing record as a failure rather than as
                          nothing to do.
                        -->
                        <hamstrack.test-run.id>${maven.build.timestamp}</hamstrack.test-run.id>
                        <hamstrack.test-run.build-dir>${project.build.directory}</hamstrack.test-run.build-dir>

                        <spring.datasource.hikari.maximum-pool-size>4</spring.datasource.hikari.maximum-pool-size>
                        <spring.datasource.hikari.minimum-idle>0</spring.datasource.hikari.minimum-idle>
                        <app.expensive-read.max-in-flight>2</app.expensive-read.max-in-flight>
                        <app.expensive-read.max-in-flight-per-principal>2</app.expensive-read.max-in-flight-per-principal>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
              HD-265: THE STEP THAT REFUSES A RUN THAT SILENTLY SKIPPED PART OF THE TREE.

              An unfiltered `mvnw test` reported `Tests run: 1463, Failures: 0, Errors: 0` and BUILD
              SUCCESS while executing 224 of 252 test classes. The absent 28 were a contiguous
              alphabetical prefix — whole packages — and the run said nothing whatsoever about them;
              the author had just written a class inside the gap, so the green run was evidence about
              everything except the thing being verified. It was caught by a remembered total looking
              low, which is not a mechanism. "A filtered run is not evidence" was already project
              lore; the honest version is that AN UNFILTERED RUN IS NOT EVIDENCE EITHER UNLESS THE
              CLASS COUNT IS CHECKED. This is the check.

              WHY IT IS A BUILD STEP AND NOT A TEST. A guard shaped as a test class is selected by
              the same mechanism that failed: the dropped prefix can drop the guard, which is then
              silent exactly when it is needed. A JUnit listener is immune to test selection but
              cannot fail anything (the Launcher swallows what its callbacks throw, and System.exit
              inside a fork surfaces as "the forked VM terminated without properly saying goodbye",
              sending the reader to an unrelated question). So the two halves are split by what each
              one can do: the listener sees, this refuses. Note that the guard's own class file comes
              off the classpath below — if the truncation ever takes THAT, this step fails too.

              IT COSTS ONE SHORT-LIVED JVM. No JUnit, no Spring context, no database: the classpath
              is target/test-classes and the program reads two directories and one record file.

              ARMING. Every switch that legitimately narrows the plan is passed straight through and
              disarms the check inside SuiteCoverageGuard rather than out here, so all of it is
              readable in one place — a profile activation can only test ONE property, and this needs
              the whole category. An undefined Maven property interpolates to its own placeholder,
              which is how "not passed" reaches the program; it reads blank as unset too, so it
              behaves the same if that ever changes. An IDE builds its own command line and never
              runs a Maven phase, so IDE runs are untouched.

              ORDERING: within the `test` phase the default lifecycle binding (surefire:test) runs
              before POM-declared executions, so the record is complete by the time this reads it —
              the same ordering the frontend `npm-test` execution above depends on, verified in the
              build log for both.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <!-- version managed by the Spring Boot BOM (the <parent>); do NOT pin -->
                <executions>
                    <execution>
                        <id>test-tree-coverage-guard</id>
                        <phase>test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <!-- failonerror would end the build with "Java returned: 1", which
                                     names neither the check nor where its report went; the exit
                                     code is captured and turned into a <fail> whose message is the
                                     one line Maven prints last. The report itself is the program's
                                     stderr, a few lines above. -->
                                <java classname="com.hamstrack.common.testsupport.SuiteCoverageGuard"
                                      fork="true" failonerror="false" logError="true"
                                      resultproperty="hamstrack.test-tree.exit">
                                    <classpath>
                                        <pathelement location="${project.build.testOutputDirectory}"/>
                                    </classpath>
                                    <arg value="testSources=${project.build.testSourceDirectory}"/>
                                    <arg value="testClasses=${project.build.testOutputDirectory}"/>
                                    <arg value="buildDirectory=${project.build.directory}"/>
                                    <arg value="runId=${maven.build.timestamp}"/>
                                    <arg value="test=${test}"/>
                                    <arg value="groups=${groups}"/>
                                    <arg value="excludedGroups=${excludedGroups}"/>
                                    <arg value="skipTests=${skipTests}"/>
                                    <arg value="maven.test.skip=${maven.test.skip}"/>
                                    <arg value="maven.test.skip.exec=${maven.test.skip.exec}"/>
                                </java>
                                <fail message="This test run cannot be shown to have executed the whole tree, so its result is not evidence about whatever it left out. The [test-tree] report above says what is missing; HD-265.">
                                    <condition>
                                        <not><equals arg1="${hamstrack.test-tree.exit}" arg2="0"/></not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
