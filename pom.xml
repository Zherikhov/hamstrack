        <jjwt.version>0.12.6</jjwt.version>
        <awssdk.version>2.47.3</awssdk.version>
        <!-- HD-94: -Dfrontend.skip=true skips node install + npm install + npm run build
             — and, since HD-242, `npm test`, and since HD-300 `npm run lint` — for a
             fast backend-only loop (`mvnw test`). Keep the default false: a plain
             `mvnw package` / CI's `./mvnw -B verify` MUST still build the SPA into
             src/main/resources/static, which is what ships inside the JAR, and MUST
             still run the frontend suite and the frontend lint gate, which nothing else
             does. Note the two off-switches are not the same switch: this one drops the
             SPA from the artifact and takes every execution of the plugin with it,
             `-DskipTests` leaves the build intact and drops only the executions bound to
             a testing phase (surefire's, npm-test's and npm-lint's). -->
        <frontend.skip>false</frontend.skip>
    </properties>
